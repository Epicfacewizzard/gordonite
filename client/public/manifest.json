{
  "id": "/",
  "name": "Gordonite",
  "short_name": "Gordonite",
  "description": "Notes, daily streams and tasks on your own server.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbfaf7",
  "theme_color": "#fbfaf7",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "shortcuts": [
    { "name": "New note", "url": "/#/new", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Log skin", "url": "/#/skin", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tasks", "url": "/#/tasks", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*", "application/pdf", "*/*"] }]
    }
  }
}
