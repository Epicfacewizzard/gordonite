{
  "name": "personal-hq",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "Personal HQ: tag-based daily notes with inline tasks. Self-hosted, SQLite-backed.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite client --host",
    "build": "vite build client",
    "start": "node server/index.js",
    "preview:local": "npm run build && node scripts/preview-local.js",
    "test": "node --test \"tests/server/*.test.js\" \"tests/client/*.test.js\"",
    "test:e2e": "npm run build && node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "backup": "node server/cli.js backup",
    "restore": "node server/cli.js restore",
    "verify-backup": "node server/cli.js verify"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-unique-id": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@preact/preset-vite": "^2.10.6",
    "playwright-core": "^1.63.0",
    "vite": "^8.3.2",
    "zod": "^4.6.5"
  }
}
